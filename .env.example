# Copy this file to .env and fill in your own credentials.
# Never put real tokens in this file or commit .env to Git.
BOT_TOKEN=replace_with_your_telegram_bot_token
GITHUB_TOKEN=replace_with_your_github_personal_access_token

GITHUB_API_URL=https://api.github.com
GITHUB_TIMEOUT=15
GITHUB_CACHE_TTL=300
GITHUB_CACHE_MAX_ENTRIES=256
LOG_LEVEL=INFO
